  "db_name": "PostgreSQL",
  "query": "SELECT group_members.group_id, group_members.key_version, group_versions.bundle, group_versions.bundle_signature, group_members.sealed_key, group_members.grant_data, group_members.grant_signature, group_members.seq FROM group_members JOIN group_versions ON group_versions.group_id = group_members.group_id AND group_versions.key_version = group_members.key_version JOIN org_groups ON org_groups.id = group_members.group_id JOIN org_members ON org_members.org_id = org_groups.org_id AND org_members.account_id = group_members.account_id WHERE group_members.account_id = $1 AND org_members.status = 'confirmed'",
