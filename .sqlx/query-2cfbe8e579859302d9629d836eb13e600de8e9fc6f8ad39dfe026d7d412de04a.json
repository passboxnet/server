  "db_name": "PostgreSQL",
  "query": "SELECT g.id, g.principal_kind, g.principal_id, s.name AS \"name?\", g.client_name, g.request, g.status, g.not_after, g.decided_device, g.ip, g.created_at, g.expires_at, g.decided_at FROM agent_grants g LEFT JOIN service_accounts s ON g.principal_kind = 'service' AND s.id = g.principal_id WHERE g.account_id = $1 AND g.created_at > $2 ORDER BY g.created_at DESC LIMIT 100",
