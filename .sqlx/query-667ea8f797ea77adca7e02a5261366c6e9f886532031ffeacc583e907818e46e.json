{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.account_id, a.email AS \"email!\", r.device_name, r.ip, r.created_at, r.expires_at, r.ephemeral_key, e.key_version, e.escrow, e.escrow_signature, e.sealed_key FROM org_recovery_requests r JOIN account_directory a ON a.id = r.account_id JOIN org_recovery_escrows e ON e.org_id = r.org_id AND e.account_id = r.account_id WHERE r.org_id = $1 AND r.status = 'pending' AND r.expires_at > $2 ORDER BY r.created_at",
