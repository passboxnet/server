  "query": "SELECT items.id, items.vault_id, items.revision, items.encrypted_data, items.deleted, items.updated_at, items.key_epoch, items.created_at FROM items JOIN vaults ON vaults.id = items.vault_id WHERE vaults.account_id = $1 AND vaults.org_id IS NULL AND items.seq > $2 AND items.seq <= $3 ORDER BY items.seq",
