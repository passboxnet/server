# Copy to .env next to docker-compose.yml and fill in every value.
# Never commit .env. Generate passwords with:  openssl rand -hex 32
# (hex keeps them safe inside database URLs).

# Public host name. Its DNS A/AAAA records must point to this machine, and
# ports 80 and 443 must be reachable for the HTTPS certificate.
PASSBOX_DOMAIN=passbox.example.com
# Contact for the certificate authority (expiry notices).
ACME_EMAIL=admin@example.com

# Image to run. Pin a version (or digest) for production, e.g.
# ghcr.io/passboxnet/server:0.1.0@sha256:...
PASSBOX_IMAGE=ghcr.io/passboxnet/server:latest

# PostgreSQL superuser (used only by initdb and the backup job).
POSTGRES_PASSWORD=
# Database roles, created on the first start of the postgres container.
# Changing these later needs ALTER ROLE ... PASSWORD (see the guide).
PASSBOX_MIGRATOR_DB_PASSWORD=
PASSBOX_APP_DB_PASSWORD=
PASSBOX_WORKER_DB_PASSWORD=

# Backups: age public key (age1...). Create a key pair on another machine with
#   age-keygen -o passbox-backup-key.txt
# and keep the private key file offline; you need it to restore.
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Host directory for the encrypted backup files.
BACKUP_DIR=./backups

# Optional: outgoing mail, admins, breach monitoring.
PASSBOX_SMTP_URL=
PASSBOX_MAIL_FROM=
PASSBOX_ADMIN_EMAILS=
PASSBOX_HIBP_API_KEY=
RUST_LOG=info
